{
  "name": "solid-tv-monorepo",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "start": "pnpm dev:tv",
    "dev": "pnpm dev:tv",
    "dev:tv": "pnpm --filter tv dev",
    "dev:api": "pnpm --filter api dev",
    "build": "pnpm build:tv && pnpm build:api",
    "build:tv": "pnpm --filter tv build",
    "build:api": "pnpm --filter api build",
    "build:analyze": "pnpm --filter tv build:analyze",
    "preview": "pnpm --filter tv preview",
    "test": "pnpm --filter tv test",
    "tsc": "pnpm tsc:tv && pnpm tsc:api",
    "tsc:tv": "pnpm --filter tv tsc",
    "tsc:api": "pnpm --filter api tsc",
    "lint": "pnpm --filter tv lint",
    "lint-fix": "pnpm --filter tv lint-fix",
    "storybook": "pnpm --filter tv storybook",
    "build-storybook": "pnpm --filter tv build-storybook",
    "db:generate": "pnpm --filter api db:generate",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:deploy": "pnpm --filter api db:deploy",
    "db:seed": "pnpm --filter api db:seed",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "packageManager": "pnpm@9.4.0+sha512.f549b8a52c9d2b8536762f99c0722205efc5af913e77835dbccc3b0b0b2ca9e7dc8022b78062c17291c48e88749c70ce88eb5a74f1fa8c4bf5e18bb46c8bd83a"
}
